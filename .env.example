# ---------------------------------------------------------------------------
# Seialz CRM — environment variables
# ---------------------------------------------------------------------------
# Copy to .env (local dev) or configure in Vercel → Project → Environment
# Variables. Do NOT commit real values.
# ---------------------------------------------------------------------------

# ----- Frontend (exposed to the browser, MUST be prefixed with VITE_) ------

# Supabase project URL
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Supabase anon (publishable) key — safe to expose
VITE_SUPABASE_PUBLISHABLE_KEY=<anon-jwt>

# Supabase project ref (used by media proxy URL builder)
VITE_SUPABASE_PROJECT_ID=<project-ref>

# Sentry DSN — optional, falls back to the hardcoded project DSN if absent
VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project-id>

# ----- Build-time only (Vercel: Production scope) --------------------------
# Required for source-map upload + release creation by @sentry/vite-plugin.
# When ANY of these is missing the plugin is disabled and sourcemaps are
# NOT emitted (build still succeeds).

SENTRY_AUTH_TOKEN=<sentry-internal-integration-token>
SENTRY_ORG=<sentry-org-slug>
SENTRY_PROJECT=<sentry-project-slug>

# Optional. If unset, vite.config.ts generates a timestamped release name.
# On Vercel prefer: SENTRY_RELEASE=$VERCEL_GIT_COMMIT_SHA
SENTRY_RELEASE=
